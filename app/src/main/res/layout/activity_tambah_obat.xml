<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emerald_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Tambah Obat Baru"
            android:textColor="@color/emerald_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Masukkan informasi obat dengan lengkap"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="24dp" />

        <!-- Image Upload Section -->
        <ImageView
            android:id="@+id/ivPreviewObat"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"
            android:src="@drawable/drugs"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPilihGambar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/emerald_primary"
            android:text="Pilih Gambar"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />



        <EditText
            android:id="@+id/etNamaObatBaru"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Nama Obat"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jenis Obat"
            android:textColor="@color/emerald_dark"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerJenisObat"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Supplier"
            android:textColor="@color/emerald_dark"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerSuplier"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etStokObatBaru"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Jumlah Stok"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etHargaObatBaru"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Harga (Misal: 5000)"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etExpiredDate"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Tanggal Kadaluarsa (ED)"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnSimpanObat"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/emerald_primary"
            android:text="Simpan Data Obat"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>