<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Thumbnail -->
        <androidx.cardview.widget.CardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F0F0F0">
            <ImageView
                android:id="@+id/ivThumbnailAdmin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="6dp"
                android:src="@drawable/drugs" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvNamaObat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Obat"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/tvStokObat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stok: 50"
                android:textSize="12sp"
                android:textColor="@color/text_gray" />
            <TextView
                android:id="@+id/tvExpiredDateAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ED: -"
                android:textSize="12sp"
                android:textColor="@color/text_gray" />
        </LinearLayout>
        
        <TextView
            android:id="@+id/tvHargaObat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 5.000"
            android:textColor="@color/emerald_dark"
            android:textStyle="bold"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"/>

        <ImageButton
            android:id="@+id/btnEditObat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_gray" />

        <ImageButton
            android:id="@+id/btnHapusObat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#E74C3C" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
