<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emerald_soft"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Tambah Suplier Baru"
        android:textColor="@color/emerald_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etNamaSuplier"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/edittext_background"
        android:hint="Nama Perusahaan Suplier"
        android:paddingHorizontal="16dp" />

    <EditText
        android:id="@+id/etAlamatSuplier"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_background"
        android:hint="Alamat Lengkap"
        android:paddingHorizontal="16dp" />

    <EditText
        android:id="@+id/etTelpSuplier"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_background"
        android:hint="Nomor Telepon"
        android:inputType="phone"
        android:paddingHorizontal="16dp" />

    <EditText
        android:id="@+id/etEmailSuplier"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/edittext_background"
        android:hint="Email (Opsional)"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivLogoSuplier"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/rounded_background"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery" />

        <Button
            android:id="@+id/btnPilihLogoSuplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pilih Logo" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSimpanSuplier"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/emerald_primary"
        android:text="Simpan Data Suplier"
        android:textAllCaps="false"
        android:textStyle="bold" />

</LinearLayout>
