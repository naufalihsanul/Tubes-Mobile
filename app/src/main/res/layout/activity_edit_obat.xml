<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emerald_soft"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Edit Data Obat"
            android:textColor="@color/emerald_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubah informasi obat di bawah ini"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="24dp" />

        <!-- Image Upload Section -->
        <ImageView
            android:id="@+id/ivPreviewObatEdit"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:background="#E0E0E0"
            android:scaleType="centerCrop"
            android:src="@drawable/drugs"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPilihGambarEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:backgroundTint="@color/emerald_primary"
            android:text="Ubah Gambar"
            android:textSize="12sp"
            android:layout_marginBottom="24dp" />

        <!-- Barcode Scan Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etBarcodeEdit"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:background="@drawable/edittext_background"
                android:hint="Barcode (Opsional)"
                android:paddingHorizontal="16dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnScanBarcodeEdit"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:backgroundTint="@color/emerald_dark"
                android:text="Scan" />
        </LinearLayout>

        <EditText
            android:id="@+id/etNamaObatEdit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Nama Obat"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jenis Obat"
            android:textColor="@color/emerald_dark"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerJenisObatEdit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Supplier"
            android:textColor="@color/emerald_dark"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerSuplierEdit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etStokObatEdit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Jumlah Stok"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etHargaObatEdit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Harga (Misal: 5000)"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etExpiredDateEdit"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/edittext_background"
            android:hint="Tanggal Kadaluarsa (ED)"
            android:focusable="false"
            android:clickable="true"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:paddingHorizontal="16dp" />

        <Button
            android:id="@+id/btnSimpanObat"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/emerald_primary"
            android:text="Simpan Perubahan"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
